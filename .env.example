# Copiar a .env (no se sube al repo). En GitHub Actions estos valores van como Secrets.
# BD réplica (vacío = BD demo SQLite). Ejemplos:
#   postgresql+psycopg2://usuario_lectura:clave@host:5432/spm
#   mysql+pymysql://usuario_lectura:clave@host:3306/spm
#   mssql+pyodbc://usuario:clave@host/spm?driver=ODBC+Driver+18+for+SQL+Server
DB_URL=

DRY_RUN=true
SCOPE=all

# Correo (Gmail: smtp.gmail.com, 587, contraseña de aplicación)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram (crear bot con @BotFather)
TELEGRAM_BOT_TOKEN=

# Narrativa con LLM (opcional; sin llave se usa plantilla determinista)
ANTHROPIC_API_KEY=

# Administrador técnico (reporte de fallas)
ADMIN_EMAIL=
ADMIN_TELEGRAM_CHAT_ID=

# Pruebas seguras: redirige TODOS los mensajes a tu buzón / chat
REDIRECT_ALL_TO=
REDIRECT_TELEGRAM_CHAT_ID=
