# Copiar a .env en la raíz del repo (NUNCA se sube: el repo es público y .env está en .gitignore).
# El código acepta tal cual los nombres del .env del kit del curso (DATABASE_URL, TELEGRAM_TOKEN, TELEGRAM_ID).

# --- Base de datos (PostgreSQL del curso) ---
# DATABASE_URL        -> cuando corre desplegado en el servidor del curso (host alumnos-pgbouncer)
# DATABASE_URL_LOCAL  -> desde tu computadora con el túnel abierto (./tunel.sh, 127.0.0.1:15432)
# DB_TARGET=auto elige sola: usa DATABASE_URL si su host resuelve; si no, DATABASE_URL_LOCAL.
DATABASE_URL=postgresql://USUARIO:CLAVE@alumnos-pgbouncer:6432/NOMBRE_DB
DATABASE_URL_LOCAL=postgresql://USUARIO:CLAVE@127.0.0.1:15432/NOMBRE_DB
DB_TARGET=auto
# DB_URL tiene prioridad sobre las dos anteriores (otro motor u otra réplica). Vacío = no se usa.
DB_URL=

DRY_RUN=true
SCOPE=all

# --- Telegram (token de @BotFather; TELEGRAM_ID = tu chat_id, recibe el reporte de fallas) ---
TELEGRAM_TOKEN=
TELEGRAM_ID=

# --- Anthropic (narrativa con LLM; sin llave se usa plantilla determinista) ---
ANTHROPIC_API_KEY=
LLM_ENABLED=true

# --- Pruebas seguras: redirige TODOS los mensajes de Telegram a tu chat ---
REDIRECT_TELEGRAM_CHAT_ID=
